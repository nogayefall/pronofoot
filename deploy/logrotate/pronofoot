# PronoFoot — rotation des journaux. Copier vers /etc/logrotate.d/pronofoot puis tester :
#   logrotate --debug /etc/logrotate.d/pronofoot
# Les fichiers laravel-AAAA-MM-JJ.log sont déjà découpés par jour par Laravel (LOG_STACK=daily, 14 jours).
/var/www/pronofoot/backend/storage/logs/*supervisor*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su www-data www-data
    create 0640 www-data www-data
}

/var/www/pronofoot/backend/storage/logs/laravel.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su www-data www-data
    create 0640 www-data www-data
}
