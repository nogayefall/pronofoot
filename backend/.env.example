APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SESSION_SECURE_COOKIE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Code d’authentification (TOTP) exigé à la connexion. Laisser true en usage normal.
# « false » le désactive temporairement (le mot de passe suffit) ; toute autre valeur le laisse actif.
AUTH_TWO_FACTOR_ENABLED=true

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pilotes PronoFoot : fake en local ; api_football sélectionne les cotes API-Football.
ODDS_DRIVER=fake
FOOTBALL_DRIVER=fake
FAKE_PROVIDER_SCENARIO=baseline
# Notifications des alertes.
# NOTIFICATION_MODE : « fake » = simulation (rien n’est envoyé) ; « real » = envoi réel.
# NOTIFICATION_CHANNEL : canal principal (« log » = journal Laravel, « telegram » ; « whatsapp » n’est pas encore branché).
# NOTIFICATION_FALLBACK : canal de repli si le principal échoue (« log », « telegram » ou « none »).
NOTIFICATION_MODE=fake
NOTIFICATION_CHANNEL=log
NOTIFICATION_FALLBACK=none

# Telegram : utilisé quand NOTIFICATION_MODE=real et NOTIFICATION_CHANNEL=telegram (ou en repli).
# Jeton du robot, donné par @BotFather sur Telegram (forme 123456789:ABC…). Secret : ne jamais le partager ni le versionner.
TELEGRAM_BOT_TOKEN=
# Identifiant de la conversation qui reçoit les alertes : envoyez d’abord un message au robot, puis lisez « chat.id »
# dans la réponse de getUpdates de l’API Bot. Nombre (négatif pour un groupe). À garder privé.
TELEGRAM_CHAT_ID=
# Réglages facultatifs ; laissés vides, les valeurs par défaut s’appliquent :
# délai maximal d’une requête en secondes (10), nombre de nouvelles tentatives après un échec réseau,
# une limite d’envoi ou une erreur de Telegram (2), pause entre deux tentatives en millisecondes (1000).
TELEGRAM_TIMEOUT=
TELEGRAM_RETRIES=
TELEGRAM_RETRY_DELAY_MS=
ODDS_API_KEY=
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# À compléter selon la documentation officielle avant tout appel API-Football.
API_FOOTBALL_PROBE_URL=
API_FOOTBALL_API_KEY_HEADER=
API_FOOTBALL_TIMEOUT=10
