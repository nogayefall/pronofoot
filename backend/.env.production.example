# PronoFoot Phase 1 — modèle de backend/.env pour la production.
# Copier vers /var/www/pronofoot/backend/.env, puis renseigner chaque valeur vide.
# Ne jamais versionner le fichier .env rempli. Droits conseillés : chmod 640, propriétaire root:www-data.

APP_NAME=PronoFoot
APP_ENV=production
# Générer avec : php artisan key:generate --show (ne jamais réutiliser la clé locale)
APP_KEY=
APP_DEBUG=false
APP_URL=https://pronofoot.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Journaux : un fichier par jour, conservé 14 jours (logrotate gère les journaux Supervisor).
# Les clés, jetons et mots de passe sont masqués automatiquement dans les journaux.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Base MySQL : compte dédié avec les seuls droits sur la base pronofoot (jamais root).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pronofoot
DB_USERNAME=pronofoot_app
DB_PASSWORD=
DB_ENGINE=InnoDB

# Sessions : cookie sécurisé (HTTPS uniquement), chiffré, non lisible en JavaScript.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=pronofoot-session
SESSION_DOMAIN=null
SESSION_PATH=/

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# Pilotes de données : rester en « fake » tant que chaque pilote réel n’est pas validé.
# Réel : FOOTBALL_DRIVER=real et ODDS_DRIVER=api_football (même clé API-Football).
FOOTBALL_DRIVER=fake
ODDS_DRIVER=fake
FAKE_PROVIDER_SCENARIO=baseline

# API-Football : clé fournie par le client, envoyée dans l’en-tête x-apisports-key.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_API_KEY=
API_FOOTBALL_PROBE_URL=
API_FOOTBALL_API_KEY_HEADER=
API_FOOTBALL_TIMEOUT=10

# The Odds API : ne fournit pas les scores exacts en direct (voir docs/PASSER_EN_REEL.md).
ODDS_API_KEY=

# Notifications des alertes.
# NOTIFICATION_MODE : « fake » = simulation (rien n’est envoyé) ; « real » = envoi réel.
# NOTIFICATION_CHANNEL : canal principal (« log » = journal Laravel, « telegram » ; « whatsapp » n’est pas encore branché).
# NOTIFICATION_FALLBACK : canal de repli si le principal échoue (« log », « telegram » ou « none »).
NOTIFICATION_MODE=fake
NOTIFICATION_CHANNEL=log
NOTIFICATION_FALLBACK=none

# Telegram : utilisé quand NOTIFICATION_MODE=real et NOTIFICATION_CHANNEL=telegram (ou en repli).
# Jeton du robot, donné par @BotFather sur Telegram (forme 123456789:ABC…). Secret : ne jamais le partager ni le versionner.
TELEGRAM_BOT_TOKEN=
# Identifiant de la conversation qui reçoit les alertes : envoyez d’abord un message au robot, puis lisez « chat.id »
# dans la réponse de getUpdates de l’API Bot. Nombre (négatif pour un groupe). À garder privé.
TELEGRAM_CHAT_ID=
# Réglages facultatifs ; laissés vides, les valeurs par défaut s’appliquent :
# délai maximal d’une requête en secondes (10), nombre de nouvelles tentatives après un échec réseau,
# une limite d’envoi ou une erreur de Telegram (2), pause entre deux tentatives en millisecondes (1000).
TELEGRAM_TIMEOUT=
TELEGRAM_RETRIES=
TELEGRAM_RETRY_DELAY_MS=
